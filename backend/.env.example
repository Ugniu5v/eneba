# Copy these values into backend/.env (git-ignored) or export them in your
# shell. cmd/api loads backend/.env on start; real environment variables always
# win, so hosted platforms only need the dashboard variables.
PORT=8080

# Local SQLite database (default). Ignored when DATABASE_URL is set.
DB_PATH=./data/eneba.db

# PostgreSQL, including Supabase. DATABASE_URL overrides DB_PATH.
# Use the URL from Supabase -> Connect -> Connection string (URI tab):
#   Direct connection:          postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#   Transaction pooler (6543):  postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# The password must be URL-encoded. sslmode=require is added automatically for
# *.supabase.com / *.supabase.co hosts.
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to true when the API and frontend are served over HTTPS (Vercel, Render).
COOKIE_SECURE=false

# Seed the demo catalogue, demo account and inventory into an empty database.
# Defaults to true locally and false on Vercel, where cold starts have a short
# budget: seed once from your machine with `make seed` (or `go run ./cmd/api
# -seed`) and leave this false on the platform.
# SEED_DEMO=false

# How long the one-time seed may run before giving up, in seconds. The first
# seed inserts ~214 products and ~650 offers over the network, so it needs
# longer than a local SQLite seed. Defaults to 600.
# SEED_TIMEOUT_SECONDS=600

# PostgreSQL pool size. Defaults to 10/5 locally and 3/1 on Vercel. Keep the
# Vercel number small: each warm function instance holds its own connections.
# DB_MAX_OPEN_CONNS=10
# DB_MAX_IDLE_CONNS=5
